# --- Kafka (local Docker: only KAFKA_BROKERS) ---
KAFKA_BROKERS=localhost:9092
# Managed Kafka, e.g. Aiven free tier (SASL/SCRAM over TLS):
# KAFKA_BROKERS=kafka-xxxx.aivencloud.com:12345
# KAFKA_SASL_MECHANISM=scram-sha-256
# KAFKA_USERNAME=avnadmin
# KAFKA_PASSWORD=...
# KAFKA_CA_FILE=./ca.pem

# --- ingest ---
PORT=8080
# tenant slug → webhook secret from RestroFlow › Webhooks
TENANTS={"namaste-india-siegen":"local-dev-secret-change-me"}

# --- analytics ---
# PORT=8081
ANALYTICS_DB=./data/analytics.sqlite
ANALYTICS_GROUP_ID=restroflow-analytics
CORS_ORIGIN=*
